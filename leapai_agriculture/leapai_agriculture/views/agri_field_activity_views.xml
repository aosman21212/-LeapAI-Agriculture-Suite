<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agri_field_activity_list" model="ir.ui.view">
        <field name="name">agri.field.activity.list</field>
        <field name="model">agri.field.activity</field>
        <field name="arch" type="xml">
            <list string="Field Activities" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="field_id"/>
                <field name="crop_plan_id"/>
                <field name="activity_type"/>
                <field name="total_cost"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_agri_field_activity_form" model="ir.ui.view">
        <field name="name">agri.field.activity.form</field>
        <field name="model">agri.field.activity</field>
        <field name="arch" type="xml">
            <form string="Field Activity">
                <header>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <button name="action_set_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_stock_moves" type="object" class="oe_stat_button"
                                icon="fa-arrows-v" invisible="stock_move_count == 0">
                            <field name="stock_move_count" widget="statinfo" string="Stock Moves"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="field_id"/>
                            <field name="crop_plan_id"/>
                        </group>
                        <group>
                            <field name="activity_type"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="materials">
                            <field name="material_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="material_cost"/>
                            </group>
                        </page>
                        <page string="Labour" name="labour">
                            <field name="labor_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="hours"/>
                                    <field name="hourly_cost"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="labor_cost"/>
                            </group>
                        </page>
                        <page string="Machinery" name="machinery">
                            <field name="machinery_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="hours"/>
                                    <field name="hourly_cost"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="machinery_cost"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="total_cost"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agri_field_activity_search" model="ir.ui.view">
        <field name="name">agri.field.activity.search</field>
        <field name="model">agri.field.activity</field>
        <field name="arch" type="xml">
            <search string="Search Field Activities">
                <field name="name"/>
                <field name="field_id"/>
                <field name="crop_plan_id"/>
                <field name="activity_type"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Field" name="group_field" context="{'group_by': 'field_id'}"/>
                    <filter string="Activity Type" name="group_type" context="{'group_by': 'activity_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agri_field_activity" model="ir.actions.act_window">
        <field name="name">Field Activities</field>
        <field name="res_model">agri.field.activity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first field activity</p>
            <p>Land preparation, sowing, irrigation, fertilization, spraying, weeding or harvest.</p>
        </field>
    </record>

</odoo>
