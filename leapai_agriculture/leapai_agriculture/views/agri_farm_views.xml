<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agri_farm_list" model="ir.ui.view">
        <field name="name">agri.farm.list</field>
        <field name="model">agri.farm</field>
        <field name="arch" type="xml">
            <list string="Farms">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="field_count"/>
                <field name="total_area" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_agri_farm_form" model="ir.ui.view">
        <field name="name">agri.farm.form</field>
        <field name="model">agri.farm</field>
        <field name="arch" type="xml">
            <form string="Farm">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_fields" type="object" class="oe_stat_button" icon="fa-map-o">
                            <field name="field_count" widget="statinfo" string="Fields"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Farm Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="manager_id"/>
                            <field name="warehouse_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="city"/>
                            <field name="country_id"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="total_area"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="field_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="area"/>
                                    <field name="soil_type"/>
                                    <field name="current_crop_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_agri_farm_search" model="ir.ui.view">
        <field name="name">agri.farm.search</field>
        <field name="model">agri.farm</field>
        <field name="arch" type="xml">
            <search string="Search Farms">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="manager_id"/>
                <group>
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agri_farm" model="ir.actions.act_window">
        <field name="name">Farms</field>
        <field name="res_model">agri.farm</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first farm</p>
            <p>Register a farm, then add its fields to start planning crops.</p>
        </field>
    </record>

</odoo>
