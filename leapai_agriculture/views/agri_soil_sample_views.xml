<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agri_soil_sample_list" model="ir.ui.view">
        <field name="name">agri.soil.sample.list</field>
        <field name="model">agri.soil.sample</field>
        <field name="arch" type="xml">
            <list string="Soil Samples" editable="bottom">
                <field name="field_id"/>
                <field name="date"/>
                <field name="soil_type"/>
                <field name="ph"/>
                <field name="organic_matter"/>
                <field name="nitrogen"/>
                <field name="phosphorus"/>
                <field name="potassium"/>
                <field name="ec"/>
            </list>
        </field>
    </record>

    <record id="view_agri_soil_sample_form" model="ir.ui.view">
        <field name="name">agri.soil.sample.form</field>
        <field name="model">agri.soil.sample</field>
        <field name="arch" type="xml">
            <form string="Soil Sample">
                <sheet>
                    <group>
                        <group>
                            <field name="field_id"/>
                            <field name="date"/>
                            <field name="soil_type"/>
                        </group>
                        <group>
                            <field name="ph"/>
                            <field name="organic_matter"/>
                            <field name="ec"/>
                        </group>
                    </group>
                    <group string="NPK">
                        <field name="nitrogen"/>
                        <field name="phosphorus"/>
                        <field name="potassium"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_soil_sample" model="ir.actions.act_window">
        <field name="name">Soil Samples</field>
        <field name="res_model">agri.soil.sample</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first soil sample</p>
        </field>
    </record>

</odoo>
