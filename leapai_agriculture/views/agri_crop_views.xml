<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agri_crop_list" model="ir.ui.view">
        <field name="name">agri.crop.list</field>
        <field name="model">agri.crop</field>
        <field name="arch" type="xml">
            <list string="Crops">
                <field name="name"/>
                <field name="variety"/>
                <field name="days_to_harvest"/>
                <field name="expected_yield"/>
                <field name="yield_uom_id"/>
            </list>
        </field>
    </record>

    <record id="view_agri_crop_form" model="ir.ui.view">
        <field name="name">agri.crop.form</field>
        <field name="model">agri.crop</field>
        <field name="arch" type="xml">
            <form string="Crop">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Crop Name"/>
                        </h1>
                        <h3>
                            <field name="variety" placeholder="Variety"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="days_to_harvest"/>
                            <field name="gdd_base_temperature"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="expected_yield"/>
                            <field name="yield_uom_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_crop" model="ir.actions.act_window">
        <field name="name">Crops</field>
        <field name="res_model">agri.crop</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first crop</p>
        </field>
    </record>

</odoo>
